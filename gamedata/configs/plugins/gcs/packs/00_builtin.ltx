; Generated NPC/resource catalog. For normal editing use 10_genders.ltx,
; 15_name_dialogue_profiles.ltx and 20_portrait_pools.ltx.

[gcs_core_package]
kind = package
id = gcs
revision = 1
; Files only the old overwriting Rebase or original LASS 2.1 install. They
; overwrite GAMMA's own files, which Male and every pack's gender use, so no
; character is offered or loaded while they are present.
conflicts = configs|mod_system_zzzLASShudfix.ltx, configs|mod_system_zzzz_lass_actor_hud_deltas.ltx, configs|mod_system_zzzz_lass_female_bolt.ltx, configs|mod_system_zzzz_lass_ksg23_all_optics.ltx, configs|mod_system_zzzz_lass_thap_deltas.ltx, configs|mod_system_zzzzzz_lass_native_legs.ltx, configs|mod_system_zzzzzz_lass_player_model.ltx, configs|mod_system_zzzzzzzzzzzzzzzzzzzztv_bolt_iz_stalkera2_axuet.ltx
conflict_signatures = scripts|footstep_sounds.script|Ladies, scripts|eft_jump_sounds.script|Ladies
conflict_message = gcs_lass_conflict

[gcs_lass_dependency]
kind = package
id = lass
; Only the restructured LASS GAMMA Rebase ships this marker. Of the stock files it overwrites only the 97 documented NPC ones: 66 NPC and creature step sounds and 31 NPC suit texture files.
probe = configs|lass_gcs_female_pack_v1.ltx
; Its files are only usable while GAMMA's own files are intact.
requires = gcs

[gcs_trio_dependency]
kind = package
id = lass_original_trio
probe = configs|ui\textures_descr\ui_animated_female_original_trio.xml

[gcs_npc_builtin]
kind = npc_map
entries = gcs_specific_characters

